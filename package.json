{
  "name": "lateo-wallet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "corepack pnpm -r typecheck",
    "check:ui-safety": "node scripts/check-ui-safety.mjs",
    "check:security": "node scripts/check-security.mjs",
    "test": "vitest run",
    "build:extension:chrome": "corepack pnpm --filter @lateo-wallet/extension build:chrome",
    "build:extension:firefox": "corepack pnpm --filter @lateo-wallet/extension build:firefox",
    "build:extension": "corepack pnpm build:extension:chrome && corepack pnpm build:extension:firefox",
    "package:extension": "node scripts/package-extension.mjs",
    "verify:extension": "node apps/extension/scripts/verify-mv3.mjs",
    "build:web": "corepack pnpm --filter @lateo-wallet/web build",
    "verify:web": "node apps/web/scripts/verify-web.mjs",
    "build:desktop": "corepack pnpm --filter @lateo-wallet/desktop build",
    "verify:desktop": "node apps/desktop/scripts/verify-desktop.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.52.0",
    "svelte": "^5.35.0",
    "svelte-check": "^4.3.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
